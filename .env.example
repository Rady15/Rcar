# Server
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example

# PostgreSQL (required for production)
DATABASE_URL=postgresql://user:password@host:5432/alrufqah
DB_POOL_MAX=10
DATABASE_SSL=true

# Auth (required for production, >= 32 random chars)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_INITIAL_PASSWORD=change-this-immediately

# Optional integrations - leave disabled until real credentials are supplied
TAMM_API_URL=
TAMM_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_URL=
PAYMENT_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Bootstrap / seed policy
SEED_CATALOG=true
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@alrufqah.sa
ADMIN_NAME=System Administrator
ADMIN_PHONE=

# Webhook security
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Optional notifications/object storage
S3_REGION=
S3_PUBLIC_BASE_URL=
SMS_PROVIDER_URL=
EMAIL_PROVIDER_URL=

# Optional durable notification providers (provider endpoint + API key)
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=

# Optional operational hardening
NOTIFICATION_WORKER_ENABLED=true

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
